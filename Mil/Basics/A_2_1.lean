-- 2.1. Calculating

-- Содержание раздела:
--
-- Раздел открывает книгу примерами вычислений с вещественными числами
-- и показывает, что доказательство равенства a = b в Lean можно вести
-- как последовательность переписываний по известным тождествам —
-- почти так же, как школьное преобразование выражения на бумаге.
--
-- Основной инструмент — тактика `rw`: она находит в цели левую часть
-- указанной леммы-равенства и заменяет её на правую
-- (а с `←` — наоборот). Несколько `rw` подряд читаются как протокол
-- преобразований. Когда нужно переписать не первое, а, скажем,
-- второе вхождение выражения, используется `nth_rw`.
--
-- Для длинных цепочек равенств, где важно видеть промежуточные
-- выражения, а не только финальный результат, используется `calc` —
-- он оформляет доказательство как явную цепочку `A = B = C = ...`,
-- где каждый переход обосновывается отдельно. Это заметно улучшает
-- читаемость по сравнению с последовательностью голых `rw`.
--
-- Отдельно показывается, что многие такие тождества (следствия одних
-- только аксиом коммутативного кольца — ассоциативности,
-- коммутативности, дистрибутивности) можно закрыть автоматически
-- тактикой `ring`, не выписывая цепочку `rw` вручную.
-- Момент, когда стоит перейти от ручного `rw` к `ring`, —
-- важный практический навык: `ring` работает, только если тождество
-- следует из аксиом кольца без привлечения дополнительных гипотез
-- из контекста.
--
-- Также вводятся базовые понятия состояния доказательства
-- (proof state): контекст — объекты и именованные гипотезы,
-- доступные в данный момент, и цель (goal) после символа `⊢` —
-- то, что предстоит доказать. Команда `#check` показывает тип
-- любого выражения, будь то объект или доказательство факта,
-- а `variable`/`section` позволяют объявить общие переменные
-- один раз и ограничить область их действия.

import Mathlib

-- Обычно мы производим математические вычисления, не задумываясь,
-- что это доказательства. Но когда каждый шаг вычисления приходится
-- обосновывать — а именно этого требует Lean — результатом
-- оказывается доказательство того, что левая часть равенства
-- равна правой.
--
-- Сформулировать теорему в Lean — то же самое, что сформулировать
-- цель: цель доказать эту теорему. Тактика `rw` (rewrite) заменяет
-- в цели левую часть указанного тождества на правую.
-- `mul_assoc a b c` — это тождество `a * b * c = a * (b * c)`,
-- а `mul_comm a b` — тождество `a * b = b * a`. У Lean есть
-- автоматизация, которая обычно избавляет от необходимости явно
-- ссылаться на такие факты, но здесь они полезны для иллюстрации.
-- Умножение в Lean левоассоциативно, поэтому левую часть `mul_assoc`
-- можно было бы записать и как `(a * b) * c` — но хороший стиль
-- соответствует нотационным соглашениям Lean и опускает скобки
-- там, где их опускает сам Lean.

example (a b c : ℝ) : a * b * c = b * (a * c) := by
  rw [mul_comm a b]
  rw [mul_assoc b a c]

-- Символ `ℝ` печатается как `\R` или `\real`
-- (символ появляется после пробела/tab). Если навести курсор
-- на символ, VS Code покажет последовательность для его ввода;
-- Ctrl-Shift-P → «Lean 4: Show Unicode Input Abbreviations»
-- выведет список всех сокращений.
--
-- Пока курсор стоит внутри тактического доказательства, окно Lean
-- Infoview показывает текущее состояние доказательства. Типичное
-- состояние выглядит так:
--
--   1 goal
--   x y : ℕ,
--   h₁ : Prime x,
--   h₂ : ¬Even x,
--   h₃ : y > x
--   ⊢ y ≥ 4
--
-- Строки до `⊢` — контекст: объекты (x y : ℕ) и предположения
-- (h₁, h₂, h₃), доступные в этой точке доказательства.
-- Всё в контексте обязано иметь имя — `h\1`, `h\2`, `h\3` тут лишь
-- пример, годится любой корректный идентификатор
-- (`h1`, `foo`, `bar`, ...). Последняя строка после `⊢` — цель
-- (target), то, что требуется доказать; иногда «target» называют
-- именно доказываемый факт, а «goal» — сочетание контекста
-- и target'а, но на практике разница обычно ясна из контекста
-- употребления.
--
-- Стрелка влево (`\l`) в `rw` разворачивает тождество:
-- `rw [← mul_assoc a b c]` заменит `a * (b * c)` на `a * b * c`.
-- Направление стрелки — это направление переписывания
-- внутри самого тождества (справа налево), оно никак не связано
-- с левой/правой частью цели.

example (a b c : ℝ) : c * b * a = b * (a * c) := by
  rw [mul_assoc c b a]
  rw [mul_comm c (b * a)]
  rw [mul_assoc b a c]

example (a b c : ℝ) : c * b * a = b * (a * c) := by
  rw [mul_comm c b]
  rw [mul_assoc b c a]
  rw [mul_comm c a]

-- Такие тождества, как `mul_assoc` и `mul_comm`, можно применять
-- и без аргументов вовсе — тогда `rw` пытается сопоставить левую
-- часть с первым подходящим по образцу выражением, найденным в цели.

example (a b c : ℝ) : a * (b * c) = b * (a * c) := by
  rw [mul_comm]
  rw [mul_comm a c]
  rw [mul_assoc]

example (a b c : ℝ) : a * b * c = b * c * a := by
  rw [mul_assoc]
  rw [mul_comm]

-- Можно передавать и частичную информацию: `mul_comm a`
-- сопоставляется с любым образцом вида `a * ?`
-- и заменяет его на `? * a`.

example (a b c : ℝ) : a * (b * c) = b * (c * a) := by
  rw [mul_comm a]
  rw [mul_assoc b c]

example (a b c : ℝ) : a * (b * c) = b * (a * c) := by
  rw [mul_comm a]
  rw [mul_assoc b]
  rw [mul_comm a]

-- Тактика `rw` умеет пользоваться и фактами из локального контекста,
-- а не только именованными леммами из библиотеки.

example (a b c d e f : ℝ)
  (h₁ : a * b = c * d)
  (h₂ : e = f) : a * (b * e) = c * (d * f) := by
  rw [h₂]
  rw [← mul_assoc]
  rw [h₁]
  rw [mul_assoc]

-- Пробуем то же самое с `sub_self`.

example (a b c d e f : ℝ)
  (h : b * c = e * f) : ((a * b) * c) * d = a * e * f * d := by
  rw [mul_assoc a b c]
  rw [h]
  rw [← mul_assoc]

-- Переписывание работает и внутри гипотезы контекста:
-- `rw [mul_comm a b] at hyp` заменит `a * b` на `b * a` в `hyp`,
-- а не в цели. Когда после серии таких переписываний гипотеза
-- совпадает с целью буквально, её можно подставить тактикой
-- `exact` — в отличие от `apply`, `exact` ожидает уже полностью
-- готовое доказательство и не порождает новых целей.
example (a b c d : ℝ)
  (hyp₁ : c = b * a - d)
  (hyp₂ : d = a * b) : c = 0 := by
  rw [hyp₂] at hyp₁
  rw [mul_comm] at hyp₁
  rw [sub_self (a * b)] at hyp₁
  exact hyp₁

-- Несколько `rw` можно объединить в одну команду, перечислив нужные
-- тождества через запятую внутри квадратных скобок; промежуточные
-- состояния по-прежнему можно увидеть, поставив курсор после
-- очередной запятой.
--
-- Ещё один приём — объявить переменные один раз снаружи `example`
-- или `theorem` через `variable`: Lean автоматически подключает их
-- везде, где они дальше встречаются. Область действия такого
-- объявления можно ограничить, обернув его в `section ... end`.
--
-- Команда `#check` показывает тип выражения — как для объектов
-- (`#check a` даёт `a : ℝ`), так и для фактов/доказательств
-- (`#check mul_comm a b` даёт доказательство `a * b = b * a`).
-- Аннотация `#check (a : ℝ)` фиксирует ожидание, что тип `a` —
-- именно `ℝ`, и Lean сообщит об ошибке, если это не так.

section

variable (a b c d e f : ℝ)

#check a
#check a + b
#check (a : ℝ)
#check mul_comm a b
#check (mul_comm a b : a * b = b * a)
#check mul_assoc c a b
#check mul_comm a
#check mul_comm

example
  (h₁ : a * b = c * d)
  (h₂ : e = f) : a * (b * e) = c * (d * f) := by
  rw [h₂, ← mul_assoc, h₁, mul_assoc]

end

-- Лемма `two_mul a` утверждает `2 * a = a + a`; `add_mul` и `mul_add`
-- — это дистрибутивность умножения относительно сложения справа
-- и слева; `add_assoc` — ассоциативность сложения.
example (a b : ℝ) : (a + b) * (a + b) = a * a + 2 * (a * b) + b * b := by
  rw [mul_add, add_mul, add_mul]
  rw [← add_assoc, add_assoc (a * a)]
  rw [mul_comm b a, ← two_mul]

-- Цепочку голых `rw` выше можно понять, только пошагово прокликав
-- её в редакторе, — сама по себе она плохо читается. Тактика `calc`
-- даёт более структурированный способ записи такого доказательства.
--
-- Выражение, начинающееся с `calc`, — это не тактика, а терм
-- доказательства, поэтому оно не начинается с `by` (хотя `calc`
-- можно использовать и внутри тактического доказательства — тогда
-- Lean воспринимает получившийся терм как решение текущей цели).
-- Синтаксис `calc` привередлив к форме: подчёркивания `_`
-- и обоснования должны идти именно в показанном формате, а отступы
-- значимы — по ним Lean определяет начало и конец блока тактик
-- или calc-блока.
--
-- Практичный способ писать calc-доказательство — сначала набросать
-- всю цепочку равенств с `sorry` вместо обоснований, убедиться,
-- что Lean принимает такое выражение (с точностью до `sorry`),
-- и только затем обосновывать каждый шаг тактиками по отдельности.

example (a b : ℝ) : (a + b) * (a + b) = a * a + 2 * (a * b) + b * b :=
  calc
    (a + b) * (a + b) = a * a + b * a + (a * b + b * b) := by
      rw [mul_add, add_mul, add_mul]
    _ = a * a + (b * a + a * b) + b * b := by
      rw [← add_assoc, add_assoc (a * a)]
    _ = a * a + 2 * (a * b) + b * b := by
      rw [mul_comm b a, ← two_mul]

section

variable (a b c d : ℝ)

example : (a + b) * (c + d) = a * c + a * d + b * c + b * d := by
  rw [mul_add, add_mul, add_mul]
  rw [add_assoc, ← add_assoc (b * c)]
  rw [add_comm (b * c) (a * d)]
  rw [← add_assoc, ← add_assoc]


example : (a + b) * (c + d) = a * c + a * d + b * c + b * d :=
  calc
    (a + b) * (c + d) = a * c + b * c + (a * d + b * d) := by
      rw [mul_add, add_mul, add_mul]
    _ = a * c + (b * c + a * d + b * d) := by
      rw [add_assoc, ← add_assoc (b * c)]
    _ = a * c + (a * d + b * c + b * d) := by
      rw [add_comm (b * c) (a * d)]
    _ = a * c + a * d + b * c + b * d := by
      rw [← add_assoc, ← add_assoc]
end

section
variable (a b c : ℝ)

example : (a + b) * (a - b) = a ^ 2 - b ^ 2 := by
  rw [pow_two, pow_two]
  rw [add_mul, mul_sub, mul_sub]
  rw [mul_comm b a]
  rw [add_sub]
  rw [add_comm]
  rw [add_sub]
  rw [add_comm]
  rw [← add_sub]
  rw [sub_self]
  rw [add_zero]

#check pow_two a
#check mul_sub a b c
#check add_mul a b c
#check add_sub a b c
#check sub_sub a b c
#check add_zero a

end

-- Ранее мы уже переписывали внутри гипотезы (`rw [...] at hyp₁`),
-- но вот более развёрнутый пример из книги на ту же механику:
-- цепочка `rw ... at hyp` постепенно преобразует саму гипотезу,
-- пока та не совпадёт с целью буквально, — и тогда `exact hyp`
-- завершает доказательство, потому что `hyp` в этой точке в точности
-- решает цель.
example (a b c d : ℝ) (hyp : c = d * a + b) (hyp' : b = a * d) : c = 2 * a * d := by
  rw [hyp'] at hyp
  rw [mul_comm d a] at hyp
  rw [← two_mul (a * d)] at hyp
  rw [← mul_assoc 2 a d] at hyp
  exact hyp

section
variable (a b c : ℝ)

-- Тактика `ring` позволяет доказывать равенства для любого
-- коммутативного кольца. Для этого требуется, чтобы эти равенства
-- напрямую следовали только из аксиом кольца, без необходимости
-- дополнительно использовать локальные гипотезы. Она подключается
-- неявно вместе с теорией вещественных чисел (в этом файле —
-- через `import Mathlib`), а явно её можно подключить командой
-- `import Mathlib.Tactic`. Для других алгебраических структур
-- в Mathlib есть похожие тактики-автоматизаторы (см. раздел 2.2).

example : c * b * a = b * (a * c) := by
  ring

example : (a + b) * (a + b) = a * a + 2 * (a * b) + b * b := by
  ring

example : (a + b) * (a - b) = a ^ 2 - b ^ 2 := by
  ring

example (hyp : c = d * a + b) (hyp' : b = a * d) : c = 2 * a * d := by
  -- Сначала самостоятельно используем наши локальные,
  -- тк ring их не умеет использовать.
  rw [hyp, hyp']
  -- Только теперь можно применить ring.
  ring
end

-- У `rw` есть вариант `nth_rw`, позволяющий переписать не любое,
-- а конкретное по счёту вхождение выражения в цели: совпадения
-- нумеруются начиная с 1. Ниже `nth_rw 2 [h]` заменяет именно
-- второе вхождение `a + b` на `c`, оставляя первое нетронутым.
example (a b c : ℕ) (h : a + b = c) :
  (a + b) * (a + b) = a * c + b * c := by
  nth_rw 2 [h]
  rw [add_mul]
